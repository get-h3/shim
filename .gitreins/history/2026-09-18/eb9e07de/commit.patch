+    def test_install_without_name_fails_loudly(self, cfg_path, runner):
+        """Neither NAME nor --name: fail loudly, never install unnamed."""
+        result = runner.invoke(hermes_h3, ["install", "--endpoint", "http://x:1"])
+        assert result.exit_code != 0
